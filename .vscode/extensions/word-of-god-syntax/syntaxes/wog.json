{
  "scopeName": "source.wog",
  "name": "Word of God",
  "fileTypes": ["wog"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.wog",
      "begin": "//",
      "end": "$"
    },
    "strings": {
      "name": "string.quoted.double.wog",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.wog",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.entry.wog",
          "match": "(?i)\\b(and god said|and it came to pass)\\b"
        },
        {
          "name": "keyword.control.flow.wog",
          "match": "(?i)\\b(go ye unto|ye shall not)\\b"
        },
        {
          "name": "keyword.declaration.wog",
          "match": "(?i)\\b(let there be|thou shalt)\\b"
        },
        {
          "name": "keyword.control.error.wog",
          "match": "(?i)\\b(woe unto)\\b"
        },
        {
          "name": "keyword.control.output.wog",
          "match": "(?i)\\bbehold\\b"
        },
        {
          "name": "constant.language.boolean.wog",
          "match": "(?i)\\bverily, verily\\b"
        },
        {
          "name": "keyword.operator.arithmetic.wog",
          "match": "(?i)\\band\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.wog",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "labels": {
      "name": "entity.name.label.wog",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s+[0-9]+:[0-9]+\\b"
    },
    "identifiers": {
      "name": "variable.other.wog",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}